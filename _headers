/*
  _headers — Security & cache headers served by GitHub Pages / Netlify CDN.
  These apply BEFORE the response reaches the browser, adding an extra
  layer on top of the meta tags in each HTML file.

  Project 2 requirements covered:
    ✓ HTTPS enforcement (via HSTS)
    ✓ XSS protection header
    ✓ Clickjacking protection (X-Frame-Options)
    ✓ Content Security Policy
    ✓ Performance caching for static assets
*/

# ── Applied to every page ───────────────────────────────────────────────
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; script-src 'self'

# ── Aggressive caching for static assets (Performance Optimization) ─────
/css/*
  Cache-Control: public, max-age=604800, immutable

/js/*
  Cache-Control: public, max-age=604800, immutable

# ── No caching for HTML (so updates are picked up instantly) ─────────────
/*.html
  Cache-Control: no-cache, must-revalidate
